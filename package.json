{
  "name": "@kubekpanel/extension-sdk",
  "version": "0.1.0",
  "description": "Type contract for Kubek panel extensions",
  "license": "MIT",
  "author": "KubekPanel",
  "homepage": "https://github.com/KubekPanel/extension-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KubekPanel/extension-sdk.git"
  },
  "keywords": ["kubek", "extension", "panel", "sdk", "types"],
  "type": "module",
